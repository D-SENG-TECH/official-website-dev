{%- set t = i18n[lang.code] -%}
{#- Detail pages pass page_title / page_description as computed data -#}
{%- set page_title = page_title or (t[page_key].title if page_key != "home" else t.home.title) -%}
{%- set page_description = page_description or t[page_key].description or t.meta.default_description -%}
{%- set in_business = page_path.startsWith("business/") -%}
<!doctype html>
<html lang="{{ lang.html }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page_key == "home" %}{{ t.common.company_name }} | {{ t.common.company_name_en }}{% else %}{{ page_title }} | {{ t.common.company_short }}{% endif %}</title>
  <meta name="description" content="{{ page_description }}">
  {%- if site.env == "dev" or noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  <link rel="canonical" href="{{ site.url }}{{ lang.prefix }}{{ page_path }}">
  {%- for l in site.langs %}
  <link rel="alternate" hreflang="{{ l.html }}" href="{{ site.url }}{{ l.prefix }}{{ page_path }}">
  {%- endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/{{ page_path }}">
  {%- set page_url = site.url + lang.prefix + page_path %}
  {%- set og_title = (t.common.company_name + " | " + t.common.company_name_en) if page_key == "home" else (page_title + " | " + t.common.company_short) %}
  {%- set og_description = t.meta.og_description if page_key == "home" else page_description %}
  {%- set og_image = site.url + "/assets/og/d-seng-" + lang.code + ".jpg" %}
  <meta name="theme-color" content="#14284b">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ t.common.company_short }}">
  <meta property="og:locale" content="{{ lang.og_locale }}">
  {%- for l in site.langs %}{% if l.code != lang.code %}
  <meta property="og:locale:alternate" content="{{ l.og_locale }}">
  {%- endif %}{% endfor %}
  <meta property="og:url" content="{{ page_url }}">
  <meta property="og:title" content="{{ og_title }}">
  <meta property="og:description" content="{{ og_description }}">
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:type" content="image/jpeg">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ t.common.company_name }} — {{ t.meta.og_description }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ og_title }}">
  <meta name="twitter:description" content="{{ og_description }}">
  <meta name="twitter:image" content="{{ og_image }}">
  <script type="application/ld+json">
  {%- set org = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": site.url + "/#organization",
    "name": t.common.company_name,
    "alternateName": [t.common.company_name_en, t.common.company_short],
    "url": site.url + lang.prefix,
    "logo": site.url + "/assets/logo-512.png",
    "image": og_image,
    "description": t.meta.default_description,
    "email": site.email_info,
    "telephone": site.phone_intl,
    "faxNumber": site.fax_intl,
    "address": {
      "@type": "PostalAddress",
      "streetAddress": site.org_address.street,
      "addressLocality": site.org_address.locality,
      "addressRegion": site.org_address.region,
      "postalCode": site.org_address.postal_code,
      "addressCountry": "TW"
    },
    "geo": { "@type": "GeoCoordinates", "latitude": site.office.lat, "longitude": site.office.lng }
  } %}
  {{ org | dump | safe }}
  </script>
  {%- if page_key == "business_item" or page_key == "gold_stone" %}
  {%- set crumb_parent = ({ "name": t.business.title, "path": "business/" }) if page_key == "business_item" else ({ "name": t.about.title, "path": "about/" }) %}
  <script type="application/ld+json">
  {%- set crumbs = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": t.common.company_short, "item": site.url + lang.prefix },
      { "@type": "ListItem", "position": 2, "name": crumb_parent.name, "item": site.url + lang.prefix + crumb_parent.path },
      { "@type": "ListItem", "position": 3, "name": page_title, "item": page_url }
    ]
  } %}
  {{ crumbs | dump | safe }}
  </script>
  {%- endif %}
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ lang.font }}:wght@400;500;700&display=swap">
  <link rel="stylesheet" href="/styles.css">
  {%- if site.gtm_id and site.env == "production" %}
  <script async src="https://www.googletagmanager.com/gtm.js?id={{ site.gtm_id }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    dataLayer.push({ site_lang: "{{ lang.code }}" });
  </script>
  {%- endif %}
  {%- if password_gate %}
  <style>.gate { display: none; } html.gate-locked .gate { display: grid; } html.gate-locked main { display: none; }</style>
  <script>
    /* Password gate: page scripts wait on window.pageUnlocked before loading anything heavy */
    (() => {
      const key = "dseng_gate";
      let ok = false;
      try { ok = sessionStorage.getItem(key) === "{{ site.gate_hash }}"; } catch {}
      let unlock;
      window.pageUnlocked = new Promise((r) => (unlock = r));
      window.__gateUnlock = () => { document.documentElement.classList.remove("gate-locked"); unlock(); };
      if (ok) unlock(); else document.documentElement.classList.add("gate-locked");
    })();
  </script>
  {%- endif %}
</head>
<body class="lang-{{ lang.code }}">
  {%- if site.gtm_id and site.env == "production" %}
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtm_id }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  {%- endif %}
  <a class="skip-link" href="#main">{{ t.common.skip_to_content }}</a>
  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="brand" href="{{ lang.prefix }}">
        <img class="brand__logo" src="/assets/logo.svg" width="2246" height="512" alt="{{ t.common.company_name }}">
        <span class="visually-hidden">{{ t.nav.home }}</span>
      </a>
      <button type="button" class="nav-toggle" aria-controls="site-nav" aria-expanded="false">
        <span class="nav-toggle__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="visually-hidden">{{ t.common.menu }}</span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="{{ t.common.menu }}">
        {%- for key in ["about", "business", "careers", "downloads", "contact"] %}
        {%- set path = key + "/" %}
        {%- if key == "business" %}
        <span class="site-nav__label" aria-hidden="true">{{ t.nav.business }}</span>
        {%- for item in t.business.items %}
        {%- set item_path = path + (item.id | replace("_", "-")) + "/" %}
        <a class="site-nav__sub" href="{{ lang.prefix }}{{ item_path }}"{% if page_path == item_path %} aria-current="page"{% endif %}>{{ item.nav }}</a>
        {%- endfor %}
        {%- else %}
        <a href="{{ lang.prefix }}{{ path }}"{% if page_path == path %} aria-current="page"{% elif page_path.startsWith(path) %} aria-current="true"{% endif %}>{{ t.nav[key] }}</a>
        {%- endif %}
        {%- endfor %}
      </nav>
      <details class="lang-switch">
        <summary><span class="lang-switch__icon" aria-hidden="true">文A</span><span>{{ lang.label }}</span><span class="visually-hidden">（{{ t.common.language }}）</span></summary>
        <ul>
          {%- for l in site.langs %}
          <li><a href="{{ l.prefix }}{{ page_path }}" hreflang="{{ l.html }}" lang="{{ l.html }}"{% if l.code == lang.code %} aria-current="true"{% endif %}>{{ l.label }}</a></li>
          {%- endfor %}
        </ul>
      </details>
    </div>
  </header>
  <script>
  (() => {
    /* Mobile menu: the hamburger toggles the nav panel under the header */
    const header = document.querySelector(".site-header");
    const btn = header.querySelector(".nav-toggle");
    const nav = header.querySelector(".site-nav");
    const mq = matchMedia("(max-width: 1000px)");
    const setOpen = (open) => {
      header.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", open);
      document.documentElement.classList.toggle("nav-open", open);
    };
    btn.addEventListener("click", () => setOpen(!header.classList.contains("is-open")));
    nav.addEventListener("click", (e) => { if (e.target.closest("a")) setOpen(false); });
    addEventListener("keydown", (e) => { if (e.key === "Escape" && header.classList.contains("is-open")) { setOpen(false); btn.focus(); } });
    document.addEventListener("click", (e) => { if (header.classList.contains("is-open") && !header.contains(e.target)) setOpen(false); });
    mq.addEventListener("change", () => setOpen(false));
  })();
  </script>

  {%- if password_gate %}
  <section class="gate" aria-labelledby="gate-title">
    <form class="gate__form" id="gate-form">
      <h1 id="gate-title">{{ t.common.gate_title }}</h1>
      <label for="gate-pw">{{ t.common.gate_label }}</label>
      <input id="gate-pw" type="password" inputmode="numeric" autocomplete="off" required>
      <button class="button" type="submit">{{ t.common.gate_submit }}</button>
      <p class="gate__error" id="gate-error" role="alert" hidden>{{ t.common.gate_error }}</p>
    </form>
  </section>
  <script>
    document.getElementById("gate-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const pw = document.getElementById("gate-pw");
      const buf = await crypto.subtle.digest("SHA-256", new TextEncoder().encode("d-seng-gate:" + pw.value));
      const hex = [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, "0")).join("");
      if (hex === "{{ site.gate_hash }}") {
        try { sessionStorage.setItem("dseng_gate", hex); } catch {}
        window.__gateUnlock();
      } else {
        document.getElementById("gate-error").hidden = false;
        pw.select();
      }
    });
  </script>
  {%- endif %}
  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__grid">
      <div>
        <img class="site-footer__logo" src="/assets/logo-dark.svg" width="2246" height="512" alt="{{ t.common.company_name }}" loading="lazy">
      </div>
      <div>
        <p>{{ t.common.address }}</p>
        <p>{{ t.common.phone_label }} <a href="tel:{{ site.phone_tel }}">{% if lang.code == "zh-tw" %}{{ site.phone }}{% else %}{{ site.phone_intl }}{% endif %}</a>　{{ t.common.fax_label }} {% if lang.code == "zh-tw" %}{{ site.fax }}{% else %}{{ site.fax_intl }}{% endif %}</p>
        <p>{{ t.common.email_label }} <a href="mailto:{{ site.email_info }}">{{ site.email_info }}</a></p>
      </div>
    </div>
    <div class="wrap site-footer__bottom">
      <span>© 2026 {{ t.common.company_name_en }}</span>
      <a class="build" href="{{ site.repo }}{% if site.build_commit %}/commit/{{ site.build_commit }}{% endif %}" title="{{ t.common.version_label }}">{% if site.env == "dev" %}DEV · {% endif %}{{ site.build_version }}</a>
    </div>
  </footer>
</body>
</html>
